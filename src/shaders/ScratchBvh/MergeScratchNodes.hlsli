#ifndef _MERGE_SCRATCH_NODES_HLSL
#define _MERGE_SCRATCH_NODES_HLSL

#define REDUCE_REGISTER 1

uint GetSharedChildren(uint laneGroupIndex, uint childIndex);
void SetSharedChildren(uint laneGroupIndex, uint childIndex, uint value);

// Min-node packing: WideNodeMergingFlags 0x10 (18 = two pass merging + min node pack). The bit is defined in
// shared/rayTracingDefs.h (WIDE_NODE_MERGING_FLAG_MIN_NODE_PACK).
// Instead of only merging consecutive slots as they are, reorder the box children with a LUT so merging leaves the
// fewest nodes (PackLeafOnlyMergeGroups).

#include "../../shadersClean/common/LaneGroup.hlsli"
#include "../../shadersClean/common/ScratchWideNode.hlsli"
#include "../../shadersClean/common/ObbCommon.hlsli"
#include "../../shadersClean/build/BuildCommonScratch.hlsli"
#include "../EncodeHwBvhCommon3_1.hlsl"

//=====================================================================================================================
static bool ShouldCompleteMerge(
    in uint mergedCount)
{
    if (mergedCount > 8)
    {
        return true;
    }

    return false;
}

//=====================================================================================================================
// Min-node packing (WideNodeMergingFlags 0x10): reorder the box children of one parent so that consecutive merging
// leaves the fewest nodes. Ported from /home/grvermeer/pack8 (pack8.cuh).
//   Size = number of children of a box child (numBoxes + numLeaves, 1..8). Consecutive boxes merge while their sizes
//   sum to 8 or less.
//   The LUT holds the order that gives the fewest nodes for each multiset of 8 sizes (6435 in total)
//   (LutBuffer.mergePackLut, data in shared/gpurtMergePackLut.h, generated by tools/genMergePackLut.py).
//   1. Sort the sizes (per lane: number of smaller keys = sorted position)
//   2. Read the LUT entry at the rank of the sorted size multiset
//   3. Move the box child node contents between slots in LUT order
//      Each slot keeps its scratch index, so the "leader + 1, + 2, ... = follower" rule (OBB refit) still holds.
//      ScratchWideNode has no parent reference, so moving the contents needs no fixup in other nodes.
// Non-box slots (leaf child or empty) count as a virtual size 8 and stay in place. A size 8 always forms its own group,
// so the result is the same.
// Collapse always fills nodes with box children up to 8 slots, so a non leaf-only box has size 8 and never merges.
// The order only changes if it leaves fewer nodes than the original consecutive greedy order.
// Returns the mask of slots that start a group (MergeLeafOnlyBoxNodes ends a merge at these slots), or 0 if the order
// is unchanged.
static uint PackLeafOnlyMergeGroups(
    LaneGroup laneGroup,
    in uint   scratchWideNodesScratchOffset,
    in uint   childWideScratchIndex,           // Child scratch wide node index of this lane (slot)
    in bool   childIsBox)
{
    ScratchWideNode childNode = (ScratchWideNode)0;
    if (childIsBox)
    {
        childNode = FetchScratchWideNode(scratchWideNodesScratchOffset, childWideScratchIndex);
    }
    const uint numBoxes  = childIsBox ? bitFieldExtract(childNode.packedFlags, 0, 4) : 0;
    const uint numLeaves = childIsBox ? bitFieldExtract(childNode.packedFlags, 4, 4) : 0;
    const uint boxSize   = numBoxes + numLeaves;          // Value added to mergedCount when merging
    const uint childSize = childIsBox ? boxSize : 8u;     // Virtual size 8 for non-box slots

    const uint boxMask     = laneGroup.Ballot(childIsBox);
    const uint numBoxSlots = countbits(boxMask);
    const uint badMask     = laneGroup.Ballot(childIsBox && ((boxSize == 0) || (boxSize > 8)));
    const uint smallMask   = laneGroup.Ballot(childIsBox && (boxSize < 8)); // Slots that can merge with another box
    if ((boxMask != bits(numBoxSlots)) || (badMask != 0) || (countbits(smallMask) < 2))
    {
        return 0; // Box slots are not contiguous at the front, or fewer than 2 boxes can merge
    }

    // 0. Node count of the original order (consecutive greedy of MergeLeafOnlyBoxNodes, capacity check only)
    uint baselineCount = 0;
    uint groupSize     = 9; // 9 makes the first box start a new group
    [unroll]
    for (uint k = 0; k < 8; ++k)
    {
        const uint sizeK = laneGroup.Broadcast(childSize, k);
        if (((boxMask >> k) & 1u) != 0)
        {
            if ((groupSize + sizeK) > 8)
            {
                baselineCount++;
                groupSize = sizeK;
            }
            else
            {
                groupSize += sizeK;
            }
        }
    }

    // 1. Sort with key = (size - 1, lane). Sorted position = number of smaller keys
    // Virtual 8s have the largest lane indices, so they sort after the real 8s, at the end.
    const uint sortKey = ((childSize - 1) << 3) | laneGroup.laneIndex;
    uint sortedPos = 0;
    [unroll]
    for (uint k = 0; k < 8; ++k)
    {
        sortedPos += (laneGroup.Broadcast(sortKey, k) < sortKey) ? 1u : 0u;
    }

    // 2. Multiset rank = sum_p C(sv_p + p, p + 1), where sv_p = (p-th smallest size) - 1
    // Each lane computes its own term C(sv + p, p + 1). A product of i consecutive integers is divisible by i!, so
    // every step is exact.
    const uint sv = childSize - 1;
    uint term = 1;
    [unroll]
    for (uint i = 1; i <= 8; ++i)
    {
        term = (i <= (sortedPos + 1)) ? ((term * (sv + i - 1)) / i) : term;
    }
    const uint rank     = laneGroup.Sum(term); // 0 to 6434
    const uint lutEntry = LutBuffer.mergePackLut[rank >> 2][rank & 3];

    // 3. LUT slot that output slot p reads
    // LUT slot order: [groups of sizes 1..7][8s]
    // Output order  : [real 8s (box)][groups of sizes 1..7][virtual 8s (non-box slots, in place)]
    const uint numEights     = countbits(laneGroup.Ballot(childSize == 8)); // Real 8s + virtual 8s
    const uint numSmall      = 8 - numEights;                               // LUT slots 0..numSmall-1 hold the groups of sizes 1..7
    const uint numRealEights = numEights - (8 - numBoxSlots);
    const uint p             = laneGroup.laneIndex;
    const uint lutSlot       = (p < numRealEights) ? (numSmall + p) :
                               ((p < numBoxSlots) ? (p - numRealEights) : p);
    const uint srcSortedPos  = (lutEntry >> (3 * lutSlot)) & 7;             // Sorted position of the node this slot receives
    const bool startsGroup   = (p < numBoxSlots) && (((lutEntry >> (24 + lutSlot)) & 1u) != 0);
    const uint groupStartMask = laneGroup.Ballot(startsGroup);

    if (countbits(groupStartMask) >= baselineCount)
    {
        return 0; // Already minimal, same as the original merge
    }

    // 4. Move the node contents: slot p receives the node of the lane at sorted position srcSortedPos
    ScratchWideNode movedNode = childNode;
    uint            movedFrom = laneGroup.laneIndex;
    [unroll]
    for (uint src = 0; src < 8; ++src)
    {
        const uint   srcPos     = laneGroup.Broadcast(sortedPos, src);
        const uint4  srcC0      = laneGroup.Broadcast(childNode.children0WideNodeIndexOrLeafScratchIndex, src);
        const uint4  srcC1      = laneGroup.Broadcast(childNode.children1WideNodeIndexOrLeafScratchIndex, src);
        const float3 srcBboxMin = laneGroup.Broadcast(childNode.bbox_min, src);
        const float3 srcBboxMax = laneGroup.Broadcast(childNode.bbox_max, src);
        const uint   srcScratch = laneGroup.Broadcast(childNode.scratchIndex, src);
        const uint   srcFlags   = laneGroup.Broadcast(childNode.packedFlags, src);
        if (srcPos == srcSortedPos) // Sorted positions differ per lane, so only one matches
        {
            movedNode.children0WideNodeIndexOrLeafScratchIndex = srcC0;
            movedNode.children1WideNodeIndexOrLeafScratchIndex = srcC1;
            movedNode.bbox_min     = srcBboxMin;
            movedNode.bbox_max     = srcBboxMax;
            movedNode.scratchIndex = srcScratch;
            movedNode.packedFlags  = srcFlags;
            movedFrom              = src;
        }
    }
    GPU_ASSERT(childIsBox || (movedFrom == laneGroup.laneIndex)); // Non-box slots stay in place
    if (childIsBox && (movedFrom != laneGroup.laneIndex))
    {
        WriteScratchWideNode(scratchWideNodesScratchOffset, childWideScratchIndex, movedNode);
    }
    return groupStartMask;
}

//=====================================================================================================================
// Consecutive greedy merging method from "Memory-Efficient BVH" (HPG 2026)
// Fast top-down greedy collapsing guarantees that only leaf-only boxes are merged.
// Returns true on a follower lane (merged into its leader, a preceding sibling).
static bool MergeLeafOnlyBoxNodes(
    LaneGroup                laneGroup,
    in    uint               laneGroupIndex,
    in    uint               scratchWideNodesScratchOffset,
    in    uint               childWideScratchIndex,
    in    bool               childIsBox,
    in    uint               forcedGroupStartMask) // Slots in this mask start a new group. 0 keeps the original behavior
{
    bool isFollowerLane = false;

    // Starts with 11111111. If result of mask is 10010001,
    // that means 0,4,7 are leader nodes, 1,2,3 are followers of 0, and 5,6 are followers of 4.
    uint leaderNodeMask = bits(8); // 0b11111111
    uint childBoxMask = laneGroup.Ballot(childIsBox);
    ScratchWideNode childNode;
    if (childIsBox)
    {
        childNode = FetchScratchWideNode(scratchWideNodesScratchOffset, childWideScratchIndex);
    }
    else
    {
        childNode.children0WideNodeIndexOrLeafScratchIndex = 0xffffffff.xxxx;
        childNode.children1WideNodeIndexOrLeafScratchIndex = 0xffffffff.xxxx;
        childNode.bbox_min = float3(FLT_MAX, FLT_MAX, FLT_MAX);
        childNode.bbox_max = float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);
    }
    
    const uint numBoxesInChild  = childIsBox ? bitFieldExtract(childNode.packedFlags, 0, 4) : 0;
    const uint numLeavesInChild = childIsBox ? bitFieldExtract(childNode.packedFlags, 4, 4) : 0;
    const uint numChildrenInChild = childIsBox ? bitFieldExtract(childNode.packedFlags, 4, 4) : 0;

    // Merge Scratch Wide Node
    uint targetLane = firstbitlow(childBoxMask);
    uint numBoxesInTarget  = laneGroup.Broadcast(numBoxesInChild, targetLane);
    uint numLeavesInTarget = laneGroup.Broadcast(numLeavesInChild, targetLane);
    uint mergedCount = numBoxesInTarget + numLeavesInTarget;
    uint remaining = childBoxMask & ~(1u << targetLane);

    uint numFollowersOfCurLeader = 0; // for debugging
    // Lanegroup broadcasting is safe because all lanes are active
    while (remaining)
    {
        const uint sourceLane = firstbitlow(remaining);
        GPU_ASSERT(targetLane < 8 && sourceLane < 8);

        uint numBoxesInSource  = laneGroup.Broadcast(numBoxesInChild, sourceLane);
        uint numLeavesInSource = laneGroup.Broadcast(numLeavesInChild, sourceLane);
        mergedCount += (numBoxesInSource + numLeavesInSource);

        // Try Merge
        // A preset group boundary ends the merge without further checks (sourceLane is the same in all lanes)
        bool shouldCompleteMerge = ((forcedGroupStartMask >> sourceLane) & 1u) != 0;
        if (shouldCompleteMerge == false)
        {
            shouldCompleteMerge = ShouldCompleteMerge(mergedCount);
        }
        if (shouldCompleteMerge)
        {
            // Complete current target's merging. re-target to next lane
            targetLane = sourceLane;
            numBoxesInTarget = numBoxesInSource;
            numLeavesInTarget = numLeavesInSource;
            mergedCount = numBoxesInTarget + numLeavesInTarget;
#if SOGANG_EXPERIMENT
            if (numFollowersOfCurLeader > 0)
            {
                const uint sgDebugCountersOffset = ShaderConstants.offsets.sgDebugCounters;
                // ScratchGlobal.InterlockedAdd(sgDebugCountersOffset + numFollowersOfCurLeader * sizeof(uint), 1);
            }
            numFollowersOfCurLeader = 0;
#endif
        }
        else
        {
            // num boxes in child should be 0
            GPU_ASSERT(numBoxesInTarget == 0 && numBoxesInSource == 0);
            // Merge success
            GPU_ASSERT(laneGroup.Ballot(true) == bits(8)); // Ensure all lanes are active and executing the same branch.

            // Update bounding box
#if REDUCE_REGISTER
            const float3 sourceBboxMin = laneGroup.Broadcast(childNode.bbox_min, sourceLane);
            const float3 sourceBboxMax = laneGroup.Broadcast(childNode.bbox_max, sourceLane);
            if (laneGroup.laneIndex == targetLane)
            {
                childNode.bbox_min = min(childNode.bbox_min, sourceBboxMin);
                childNode.bbox_max = max(childNode.bbox_max, sourceBboxMax);
            }
#else
            float3 bbox_min = min(laneGroup.Broadcast(childNode.bbox_min, targetLane), laneGroup.Broadcast(childNode.bbox_min, sourceLane));
            float3 bbox_max = max(laneGroup.Broadcast(childNode.bbox_max, targetLane), laneGroup.Broadcast(childNode.bbox_max, sourceLane));
#endif
            if (laneGroup.laneIndex == sourceLane)
            {
                [unroll]
                for (uint i = 0; i < numLeavesInSource; ++i)
                {
                    if (i < 4)
                    {
                        SetSharedChildren(laneGroupIndex, i, childNode.children0WideNodeIndexOrLeafScratchIndex[i]);
                    }
                    else
                    {
                        SetSharedChildren(laneGroupIndex, i, childNode.children1WideNodeIndexOrLeafScratchIndex[i - 4]);
                    }
                }

                childNode.packedFlags = bitFieldInsert(childNode.packedFlags, 4, 4, 0);
                childNode.packedFlags = bitFieldInsert(childNode.packedFlags, 8, 1, 0);
                childNode.packedFlags = bitFieldInsert(childNode.packedFlags, 17, 3, numLeavesInTarget);
                isFollowerLane = true;
            }
            GroupMemoryBarrier();
            if (laneGroup.laneIndex == targetLane)
            {
                for (uint i = numLeavesInTarget; i < mergedCount; ++i)
                {
                    const uint sharedOffset = i - numLeavesInTarget;
                    if (i < 4)
                    {
                        childNode.children0WideNodeIndexOrLeafScratchIndex[i] = GetSharedChildren(laneGroupIndex, sharedOffset);
                    }
                    else
                    {
                        childNode.children1WideNodeIndexOrLeafScratchIndex[i - 4] = GetSharedChildren(laneGroupIndex, sharedOffset);
                    }
                }

                // bounding box
#if !REDUCE_REGISTER
                childNode.bbox_min = bbox_min;
                childNode.bbox_max = bbox_max;
#endif

                // child count
                childNode.packedFlags = bitFieldInsert(childNode.packedFlags, 4, 4, numLeavesInTarget + numLeavesInSource);
                const uint numFollowersOfTarget = bitFieldExtract(childNode.packedFlags, 17, 3);
                childNode.packedFlags = bitFieldInsert(childNode.packedFlags, 17, 3, numFollowersOfTarget + 1);
#if SOGANG_EXPERIMENT
                numFollowersOfCurLeader++;
#endif
            }
            numLeavesInTarget += numLeavesInSource;
            // Mark source node as a merge candidate. (sourceLane -> 0)
            leaderNodeMask &= ~(1u << sourceLane);

            // Clear SharedChildren
            SetSharedChildren(laneGroupIndex, laneGroup.laneIndex, 0xffffffff);
            GroupMemoryBarrier();
        }
        remaining &= ~(1u << sourceLane);
    }
#if SOGANG_EXPERIMENT
    // Flush the last leader group's count, which the loop above never flushes
    // because it only flushes on overflow (re-target), not on normal loop exit.
    if (numFollowersOfCurLeader > 0)
    {
        const uint sgDebugCountersOffset = ShaderConstants.offsets.sgDebugCounters;
        // // ScratchGlobal.InterlockedAdd(sgDebugCountersOffset + numFollowersOfCurLeader * sizeof(uint), 1);
    }
#endif

    // Clear the leaf bit in the mask.
    leaderNodeMask &= childBoxMask;

    // Update leader lane's node info
    // Mark the current lane as an leader node.
    if (childIsBox)
    {
        const bool isLeaderLane = (leaderNodeMask & (1u << laneGroup.laneIndex)) != 0;
        if (isLeaderLane)
        {
            WriteScratchWideNode(scratchWideNodesScratchOffset, childWideScratchIndex, childNode);
        }
        else
        {
            WriteScratchWideNodeData(scratchWideNodesScratchOffset, childWideScratchIndex, SCRATCH_WIDE_NODE_FLAGS_OFFSET, childNode.packedFlags);
        }
    }
    return isFollowerLane;
}

#endif // _MERGE_SCRATCH_NODES_HLSL